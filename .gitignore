# ───────────────────────────────────────────────────────────────────
# Raw WatchDuty data — large (>2 GB total) and not ours to redistribute.
# Obtain it from the WiDS Datathon 2026 Kaggle competition page and place
# the raw CSVs in data/raw/. The small derived CSVs in data/processed/
# ARE committed (they are the team's work product).
# ───────────────────────────────────────────────────────────────────
data/raw/
*.geojson

# Regenerable SQLite database (rebuilt from the schema script)
wids.db
*.db

# ───────────────────────────────────────────────────────────────────
# Python / Jupyter
# ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
.env

# ───────────────────────────────────────────────────────────────────
# Kaggle working artifacts (if run on Kaggle and synced back)
# ───────────────────────────────────────────────────────────────────
/kaggle/working/

